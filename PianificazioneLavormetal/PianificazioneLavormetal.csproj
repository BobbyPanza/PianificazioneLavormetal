<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Scripts\**" CopyToPublishDirectory="PreserveNewest" LinkBase="Scripts" />
    <!-- appsettings.json e' la configurazione locale di sviluppo (connection string con
         credenziali): fuori dal pacchetto di pubblicazione, sul server si parte da
         appsettings.template.json come descritto nel README. -->
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
  </ItemGroup>

</Project>
